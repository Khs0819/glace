        {
          "name": "Archive message (REST v2) - archive only",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 on success', function () {",
                  "  if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(1001);",
                  "    pm.expect(json.data && json.data.archived).to.eql(true);",
                  "    pm.expect(json.data.queued).to.eql(false);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
