            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "sender_name", "value": "MyBrand", "type": "text" },
                { "key": "authorized_name", "value": "Ahmed Ali", "type": "text" },
                { "key": "company_name", "value": "Example Co", "type": "text" },
                { "key": "mobile", "value": "970599999999", "type": "text" },
                { "key": "notes", "value": "Marketing SMS", "type": "text" },
                { "key": "attachment", "type": "file", "src": "", "disabled": true }
              ]
            },
            "description": "`sender_name`: 1-11 chars, must contain an English letter. `attachment` is optional (PDF/JPG/PNG, max 10 MB). Without a file, use `data.send_no` to upload later. The test script saves `send_no`.",
            "url": {
              "raw": "{{base_url}}/api/rest/v2/senders",
              "host": ["{{base_url}}"],
              "path": ["api", "rest", "v2", "senders"]
            }
          }
        },
