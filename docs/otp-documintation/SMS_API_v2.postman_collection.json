        {
          "name": "Sender requests (REST v2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const first = pm.response.json()?.data?.requests?.[0];",
                  "  if (first && first.send_no) {",
                  "    pm.collectionVariables.set('send_no', String(first.send_no));",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{api_token}}", "type": "string" }] },
            "method": "GET",
            "description": "This account's sender-name requests. Saves the first `send_no` into the collection variable.",
            "url": {
              "raw": "{{base_url}}/api/rest/v2/senders/requests",
              "host": ["{{base_url}}"],
              "path": ["api", "rest", "v2", "senders", "requests"]
            }
          }
        },
        {
          "name": "Add sender name (REST v2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const sendNo = pm.response.json()?.data?.send_no;",
                  "  if (sendNo) {",
                  "    pm.collectionVariables.set('send_no', String(sendNo));",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
