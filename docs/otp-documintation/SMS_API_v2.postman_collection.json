    {
      "name": "Messages (REST v2)",
      "item": [
        {
          "name": "Send message (REST v2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 on success', function () {",
                  "  if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(1001);",
                  "    pm.expect(json.data && json.data.provider).to.eql('queue_sms');",
                  "    pm.expect(json.data.provider_response).to.be.an('object');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{api_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"+201000000000\",\n  \"message\": \"Hello from SMS API\",\n  \"sender\": \"MyBrand\"\n}"
            },
            "description": "`sender` is required.",
            "url": {
              "raw": "{{base_url}}/api/rest/v2/messages/send",
              "host": ["{{base_url}}"],
              "path": ["api", "rest", "v2", "messages", "send"]
            }
          }
        },
