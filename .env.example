APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match the scheme + host the site is actually served on. Behind a
# TLS-terminating proxy this MUST be https, otherwise Laravel emits http://
# asset and /storage/ URLs that the browser blocks as mixed content.
# Production: APP_URL=https://back.glaceelameer.com
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Jawwal Pay (Service Bus / POS) ─────────────────────────────────────
# Sandbox: https://apitest.jawwalpay.ps  ·  credentials are issued per
# environment and are NOT interchangeable. Never commit real values.
JAWWALPAY_ENABLED=false
JAWWALPAY_BASE_URL=https://apitest.jawwalpay.ps
JAWWALPAY_USERNAME=
JAWWALPAY_PASSWORD=
# HMAC secret for secureHash (the guide also calls it apiKey)
JAWWALPAY_SECRET=
# Sandbox wallet supplied by the provider, for `jawwalpay:check --otp` only.
# Nothing in the application reads it.
JAWWALPAY_TEST_WALLET=
JAWWALPAY_LANG=AR
# secureHash shape — flip to "key" if the sandbox rejects the default
# (guide §3 contradicts itself; see App\Services\JawwalPay\SecureHash)
JAWWALPAY_HASH_ALGO=sha512
JAWWALPAY_HASH_SORT=value

# ─── SMS — one-time login codes (handoff 08) ─────────────────────────────────
#
# The storefront login is passwordless: a code is texted to the customer and
# that is the whole credential. Five drivers:
#
#   hotsms — the provider HTTP v1 API (sendbulksms.php). Username and password
#            on every call: nothing to provision, nothing to expire. THE
#            DEFAULT, and the reason is operational rather than technical — a
#            token that needs a human to renew it is a login page that goes
#            down on the morning nobody is watching.
#   smpp   — direct bind to the operator SMSC. Fewest moving parts, but the
#            port is IP-allowlisted; see the note under --- smpp ---.
#   rest   — the provider REST v2 API. Its login texts a PIN to the account
#            owner, so the token cannot be fetched automatically:
#            run `php artisan sms:login` once and paste the result below.
#   http   — any other provider that takes a plain JSON POST.
#   log    — writes the code to storage/logs. Local development only.
#
# SmsSender REFUSES "log" in production and throws at send time: a code that
# only reaches the log file is not a login.
#
# Verify with:  php artisan sms:check --to=05XXXXXXXX
SMS_DRIVER=hotsms

# The name the recipient sees, and it must be one the account has approved.
# An unapproved name is refused as 6000 on HTTP, and as ESME_RINVSRCADR (0x0A)
# on SMPP — which reads like a bad phone number and sends you hunting in the
# wrong place. `php artisan sms:check` lists the approved names.
SMS_SENDER=Glace

# --- smpp -------------------------------------------------------------------
# NOTE: as of 2026-09-05 this port is unreachable from our addresses while
# hotsms.ps answers normally — the SMSC is allowlisted separately from the web
# API. Use the hotsms driver until the provider adds the outbound address.
SMPP_HOST=37.58.92.36
SMPP_PORT=9999
SMPP_USERNAME=
SMPP_PASSWORD=
SMPP_SYSTEM_TYPE=
SMPP_TIMEOUT=15

# --- hotsms (v1) and rest (v2) — same host, same account ---------------------
# SMS_API_URL is the provider's host. v1 hangs off /sendbulksms.php and
# /getbalance.php; v2 off /api/rest/v2. The username and password are the
# portal credentials, and default to the SMPP pair below when left blank.
SMS_API_URL=https://hotsms.ps
SMS_API_USERNAME=
SMS_API_PASSWORD=
SMS_API_TIMEOUT=15

# Only the rest (v2) driver needs a token. Obtain it with `php artisan
# sms:login`; the hotsms driver ignores it entirely.
SMS_API_TOKEN=

# --- generic http -----------------------------------------------------------
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_HTTP_TO_FIELD=to
SMS_HTTP_BODY_FIELD=message
SMS_HTTP_TIMEOUT=15

# ─── Storefront ──────────────────────────────────────────────────────────────
#
# Minutes shown on a brand-new order's tracker, before staff set the real
# figure from the dashboard.
GLACE_PREPARATION_MINUTES=15
GLACE_DELIVERY_MINUTES=20

# Printed at the top of every receipt.
GLACE_SHOP_NAME="جلاسيه الأمير"
GLACE_SHOP_ADDRESS=
GLACE_SHOP_PHONE=
GLACE_SHOP_TAX_NUMBER=
GLACE_RECEIPT_FOOTER="شكراً لزيارتكم"

# ─── Receipt printing ────────────────────────────────────────────────────────
#
# Two paths, and both are used. The network printer gets each order the moment
# it lands, with nobody watching a screen; the cashier screen prints whatever
# the printer did not get, and is how a reprint happens. Leaving the printer
# disabled is fine — the screen covers everything on its own.
#
# CODEPAGE is a property of the hardware, not a preference:
#   CP864  — the printer expects Arabic presentation forms; we shape first.
#   CP1256 — the printer shapes for itself; we must NOT, or it doubles up.
# If Arabic prints disconnected or backwards, this is the setting to change.
#
# WIDTH is characters per line: 48 on an 80 mm head, 32 on a 58 mm one.
GLACE_PRINTER_ENABLED=false
GLACE_PRINTER_HOST=
GLACE_PRINTER_PORT=9100
GLACE_PRINTER_CODEPAGE=CP864
GLACE_PRINTER_WIDTH=48
GLACE_PRINTER_CUT=true
GLACE_PRINTER_DRAWER=false

# ─── Cashier screen ──────────────────────────────────────────────────────────
GLACE_CASHIER_POLL=10
GLACE_CASHIER_LOOKBACK=12
GLACE_CASHIER_AUTOPRINT=true
