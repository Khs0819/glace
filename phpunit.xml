<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
            The suite must never reach the real Service Bus: apitest.jawwalpay.ps
            is a live sandbox tied to the merchant account, and a stray call from
            a test spends a real request against it. Blanking the credentials
            makes the client refuse to send at all; tests that need the gateway
            fake it explicitly via fakeJawwalPay().
        -->
        <env name="JAWWALPAY_ENABLED" value="false"/>
        <env name="JAWWALPAY_BASE_URL" value="https://apitest.jawwalpay.test"/>
        <env name="JAWWALPAY_USERNAME" value=""/>
        <env name="JAWWALPAY_PASSWORD" value=""/>
        <env name="JAWWALPAY_SECRET" value=""/>
        <env name="JAWWALPAY_LOG" value="false"/>

        <!--
            Same reasoning for SMS, with an extra edge: hotsms.ps IS reachable
            and the account holds real credit, so an unpinned driver would not
            fail politely — it would text strangers and bill the shop for it.
            The URL is blanked too, so even a mis-set driver has nowhere to go.
        -->
        <env name="SMS_DRIVER" value="log"/>
        <env name="SMS_API_URL" value=""/>
        <env name="SMS_API_USERNAME" value=""/>
        <env name="SMS_API_PASSWORD" value=""/>
        <env name="SMS_API_TOKEN" value=""/>
        <env name="SMPP_USERNAME" value=""/>
        <env name="SMPP_PASSWORD" value=""/>
    </php>
</phpunit>
